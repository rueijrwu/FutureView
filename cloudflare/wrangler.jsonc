{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "futureview",
  "main": "./worker/main-frame.js",
  "compatibility_date": "2026-09-11",
  "vars": {
    "REGISTRATION_OPEN": "true"
  },
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "r2_buckets": [
    {
      "binding": "MES_DATA",
      "bucket_name": "futureview-data"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "futureview-mes-replay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_SESSION",
        "class_name": "ReplaySession"
      }
    ]
  },
  "exports": {
    "ReplaySession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
