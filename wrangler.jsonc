{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "futureview",
  "main": "./worker/main.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "RESEARCH",
      "bucket_name": "futureview-data"
    }
  ],
  "workflows": [
    {
      "name": "futureview-incremental-features",
      "binding": "INCREMENTAL_FEATURES",
      "class_name": "IncrementalFeatureWorkflow"
    }
  ],
  "triggers": {
    "crons": ["30 23 * * 1-5"]
  }
}
