{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "futureview",
  "main": "./worker/main.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "RESEARCH",
      "bucket_name": "futureview-data"
    }
  ],
  "workflows": [
    {
      "name": "futureview-incremental-features",
      "binding": "INCREMENTAL_FEATURES",
      "class_name": "IncrementalFeatureWorkflow"
    },
    {
      "name": "futureview-ranking-replay",
      "binding": "RANKING_REPLAY",
      "class_name": "RankingReplayWorkflow"
    },
    {
      "name": "futureview-backtest",
      "binding": "BACKTEST",
      "class_name": "BacktestWorkflow"
    }
  ]
}
